GEMINI_API_KEY=

# LLM/VLM provider + model selection per feature.
# Supported provider today: gemini. Other providers can be wired later without changing endpoint code.
LLM_DEFAULT_PROVIDER=gemini
PATTERN_A_LLM_PROVIDER=gemini
PATTERN_A_LLM_MODEL=gemini-3.1-flash-lite
PATTERN_B_LLM_PROVIDER=gemini
PATTERN_B_LLM_MODEL=gemini-3.1-pro-preview
PATTERN_C_LLM_PROVIDER=gemini
PATTERN_C_LLM_MODEL=gemini-3.1-pro-preview
PATTERN_D_LLM_PROVIDER=gemini
PATTERN_D_LLM_MODEL=gemini-3-flash-preview
SEED_DATA_LLM_PROVIDER=gemini
SEED_DATA_LLM_MODEL=gemini-3.1-flash-lite

# TTS provider: falai | gemini
TTS_PROVIDER=falai

# fal.ai TTS
FAL_KEY=
FALAI_TTS_MODEL=fal-ai/minimax/speech-02-hd
FALAI_TTS_VOICE_ID=Wise_Woman
FALAI_TTS_LANGUAGE_BOOST=Turkish
FALAI_TTS_AUDIO_FORMAT=mp3
FALAI_TTS_SAMPLE_RATE_HZ=32000
FALAI_TTS_TIMEOUT_SECONDS=30

# Gemini TTS fallback/alternative
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE_NAME=Sulafat
